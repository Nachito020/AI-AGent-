# Copy to .env and fill in. Never commit .env.

# Required for LLM-powered discovery and valuation (Anthropic API)
ANTHROPIC_API_KEY=

# Optional marketplace/auction credentials.
# Only used by source adapters you explicitly enable in config.yaml.
# NOTE: automated access to some marketplaces (e.g. Facebook Marketplace,
# OfferUp) violates their Terms of Service. Adapters that would require
# ToS-violating scraping are intentionally left as manual-export importers.
COPART_USERNAME=
COPART_PASSWORD=
IAA_USERNAME=
IAA_PASSWORD=
GOVDEALS_USERNAME=
GOVDEALS_PASSWORD=

# Optional: where to send deal alerts (email adapter is a stub you can wire up)
ALERT_EMAIL=
